{
  "name": "dofus-multi-account",
  "version": "1.1.0",
  "description": "Raccourcis globaux pour jouer en multi-compte sur Dofus (gestion de fenêtres Windows)",
  "author": "paradow",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win --config electron-builder.yml --publish never",
    "release": "electron-vite build && electron-builder --win --config electron-builder.yml --publish always"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "koffi": "^2.16.2",
    "node-window-manager": "^2.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
